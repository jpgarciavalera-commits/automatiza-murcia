---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const WHATSAPP_LINK = 'https://wa.me/34618324653';

const metadata = {
  title: 'Automatiza Murcia — Chatbots IA y automatizaciones para PYMEs',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Hablamos por WhatsApp',
        href: WHATSAPP_LINK,
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      { text: 'Ver paquetes y precios', href: '#precios' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Dashboard de automatización IA — Automatiza Murcia',
    }}
  >
    <Fragment slot="title">
      Tu negocio no debería perder ventas
      <span class="text-accent dark:text-white">los sábados a las 22:00</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold">Chatbots de WhatsApp 24/7</span>, automatizaciones y webs rápidas
      para clínicas, gestorías y comercios de la Región de Murcia.
      <br class="hidden md:inline" />Entrega en 7-14 días. Precio cerrado. Garantía 30 días.
    </Fragment>
  </Hero>

  <!-- Note: posicionamiento -->
  <Note
    title="Cómo trabajamos:"
    description="Precio cerrado, sin sorpresas. 50% al firmar, 50% al entregar. Garantía 30 días o devolución íntegra."
  />

  <!-- Servicios: los 3 productos -->
  <Features
    id="servicios"
    tagline="Servicios"
    title="Tres formas concretas de ahorrarte horas y recuperar leads"
    subtitle="Productos cerrados, precio fijo, sin letra pequeña. Cada uno resuelve un dolor real que sufren las PYMEs de Murcia hoy."
    items={[
      {
        title: 'Chatbot WhatsApp 24/7',
        description:
          'Contesta dudas, agenda citas y captura leads aunque tu negocio esté cerrado. Conectado a Google Calendar y a tu sistema. Escala a humano cuando hace falta.',
        icon: 'tabler:brand-whatsapp',
      },
      {
        title: 'Automatización de procesos',
        description:
          'Facturas a Holded, recordatorios de citas, sincronización entre apps, reportes mensuales… Lo que hoy hace tu equipo a mano lo hace un robot en segundos y sin errores.',
        icon: 'tabler:settings-automation',
      },
      {
        title: 'Webs rápidas que convierten',
        description:
          'Sitios en Astro que cargan en 1 segundo, posicionan en Google local y convierten visitas en clientes. Lejos del WordPress lento de hace 5 años.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Soporte continuo',
        description:
          'Mantenimiento mensual con monitorización 24/7, ajustes ilimitados, reporte mensual de métricas y soporte prioritario. Cancelable cuando quieras.',
        icon: 'tabler:headset',
      },
      {
        title: 'Garantía 30 días',
        description:
          'Si en 30 días tras la entrega el sistema no funciona como acordamos en el contrato, devolución íntegra. Sin letra pequeña, sin excusas.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Local de Murcia',
        description:
          'Vivo en Alhama de Murcia. Si te interesa, podemos vernos en persona en Murcia, Cartagena, Lorca o alrededores. Sin viajes desde Madrid.',
        icon: 'tabler:map-pin',
      },
    ]}
  />

  <!-- Precios -->
  <Pricing
    id="precios"
    title="Paquetes con precio cerrado"
    subtitle='Sin "depende", sin "consultar". Lo que ves es lo que pagas. 50% al firmar contrato, 50% al entregar.'
    prices={[
      {
        title: 'Web PYME Express',
        subtitle: 'Para autónomos y comercios con web obsoleta o ninguna',
        price: 490,
        period: '€ (pago único)',
        items: [
          { description: 'Diseño moderno en Astro' },
          { description: 'Carga en menos de 1 segundo' },
          { description: 'Formulario conectado a tu email' },
          { description: 'Botón directo a WhatsApp' },
          { description: 'SEO local básico (Google Murcia)' },
          { description: 'Entrega en 5 días' },
        ],
        callToAction: {
          target: '_blank',
          text: 'Lo quiero',
          href: WHATSAPP_LINK,
        },
      },
      {
        title: 'Chatbot WhatsApp 24/7',
        subtitle: 'Para clínicas, comercios y restaurantes que pierden leads fuera de horario',
        price: 690,
        period: '€ + 79€/mes mantenimiento',
        items: [
          { description: 'Conexión a WhatsApp Business oficial' },
          { description: 'Hasta 50 preguntas frecuentes configuradas' },
          { description: 'Agendado automático en Google Calendar' },
          { description: 'Escalado a humano cuando hace falta' },
          { description: 'Primer mes de soporte completo incluido' },
          { description: 'Entrega en 7 días' },
        ],
        hasRibbon: true,
        ribbonTitle: 'Más vendido',
        callToAction: {
          target: '_blank',
          text: 'Lo quiero',
          href: WHATSAPP_LINK,
        },
      },
      {
        title: 'Pack Automatización Despacho',
        subtitle: 'Para gestorías, asesorías y despachos profesionales',
        price: 1290,
        period: '€ + 79€/mes mantenimiento',
        items: [
          { description: 'Sincronización de facturas a Holded' },
          { description: 'Recordatorios automáticos a clientes' },
          { description: 'CRM conectado con email y formularios' },
          { description: 'Reporte mensual de actividad' },
          { description: 'Primer mes de soporte completo incluido' },
          { description: 'Entrega en 10 días' },
        ],
        callToAction: {
          target: '_blank',
          text: 'Lo quiero',
          href: WHATSAPP_LINK,
        },
      },
    ]}
  />

  <!-- Steps -->
  <Steps
    title="Cómo pasamos de tu primer mensaje a tu negocio automatizado"
    items={[
      {
        title: 'Paso 1: <span class="font-medium">Llamada de 15 minutos</span>',
        description:
          'Me cuentas qué problema concreto quieres resolver. Yo te digo si tiene sentido contratarme. Si no encaja, te lo digo directamente y no perdemos tiempo.',
        icon: 'tabler:phone',
      },
      {
        title: 'Paso 2: <span class="font-medium">Propuesta y contrato</span>',
        description:
          'Recibes una propuesta concreta con precio cerrado, plazo y entregables. Si encaja, firmas un contrato simple de 1 página y pagas el 50% para arrancar.',
        icon: 'tabler:file-check',
      },
      {
        title: 'Paso 3: <span class="font-medium">Construcción y entrega</span>',
        description:
          'En 5-14 días según el paquete tienes tu solución funcionando. Te enseño cómo usarla, te paso documentación y pagas el 50% restante.',
        icon: 'tabler:rocket',
      },
      {
        title: '¡Listo!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Proceso de trabajo Automatiza Murcia',
    }}
  />

  <!-- FAQs -->
  <FAQs
    id="faqs"
    title="Preguntas frecuentes"
    subtitle="Las dudas que más me hacen los dueños de negocio antes de contratar. Si te queda alguna que no veas aquí, escríbeme por WhatsApp."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: '¿Qué necesito tener antes de contratar?',
        description:
          'Para el chatbot: una cuenta de WhatsApp Business (gratis, te ayudo a darte de alta si no la tienes). Para la web: el contenido (texto e imágenes que quieras mostrar) y un logo. Para la automatización: acceso a las apps que uses (Holded, Gmail, etc.). Si algo falta, te lo digo en la primera llamada.',
      },
      {
        title: '¿Y si el chatbot se equivoca contestando?',
        description:
          'Por eso existe el mantenimiento mensual: monitorizo cómo va, ajusto respuestas que no funcionen bien y añado preguntas frecuentes nuevas según vea uso real. El primer mes va incluido y es donde más pulimos.',
      },
      {
        title: '¿Trabajas con clientes fuera de Murcia?',
        description:
          'Sí, todo el trabajo es remoto. He elegido Murcia porque es donde vivo y hay un mercado enorme desatendido, pero si me escribes desde Cartagena, Lorca, Alicante o Madrid te atiendo igual.',
      },
      {
        title: '¿Qué pasa si no estoy satisfecho?',
        description:
          'Tienes 30 días desde la entrega para pedir cambios o, si no funciona como acordamos en el contrato, devolución íntegra. No tengo letra pequeña: es uno u otro escenario, claro y por escrito en el contrato.',
      },
      {
        title: '¿Por qué tan barato si esto suele costar miles de euros?',
        description:
          'Porque uso IA y automatización para entregar en 7-14 días lo que hace 2 años requería un equipo de 3 personas trabajando un mes. El precio cubre mi trabajo, el coste real es bajo, y prefiero tener 10 clientes contentos a 1 cliente pagando 10x más.',
      },
      {
        title: '¿Me puedes ayudar a solicitar el Kit Digital?',
        description:
          'No soy Agente Digitalizador certificado, pero colaboro con agentes locales que sí lo son. Si tu PYME tiene derecho al bono Kit Digital (la mayoría lo tiene), te conecto con un agente y me subcontrato. Tú no pagas nada de tu bolsillo, lo paga el gobierno.',
      },
    ]}
  />

  <!-- CTA final -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Hablar por WhatsApp',
        href: WHATSAPP_LINK,
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      {
        text: 'Escribir un email',
        href: 'mailto:juanpedro@automatizamurcia.com',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">
      ¿Hablamos 15 minutos?
    </Fragment>

    <Fragment slot="subtitle">
      Sin compromiso, sin discurso comercial. Me cuentas qué necesitas y te digo
      si puedo ayudarte. Si no encaja, te lo digo directamente.
    </Fragment>
  </CallToAction>
</Layout>
