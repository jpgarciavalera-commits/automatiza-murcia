---
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';

const WHATSAPP_LINK = 'https://wa.me/34618324653';

const metadata = {
  title: 'Sobre mí — Juan Pedro García Valera',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <Hero
    tagline="Sobre mí"
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Murcia',
    }}
  >
    <Fragment slot="title">
      Soy Juan Pedro <br />
      <span class="text-accent dark:text-white">y vivo en Alhama de Murcia</span>
    </Fragment>

    <Fragment slot="subtitle">
      Construyo automatizaciones e integraciones con IA para PYMEs de la Región de Murcia.
      Mi objetivo es claro: que ningún negocio local pierda leads, ni horas, ni dinero
      en tareas repetitivas que un sistema bien montado puede hacer mejor que un humano.
    </Fragment>
  </Hero>

  <!-- Por qué hago esto -->
  <Steps2
    title="Por qué hago esto"
    subtitle="No vendo IA en abstracto. Vendo resultados medibles para negocios reales que conozco de cerca."
    items={[
      {
        title: 'El problema',
        description:
          'La mayoría de clínicas, gestorías y comercios de Murcia siguen contestando WhatsApp a las 23:00 o llevando facturas en Excel. Pierden 8-15 horas a la semana en tareas que un robot puede hacer mejor.',
      },
      {
        title: 'La oportunidad',
        description:
          'Hace 2 años montar un chatbot decente costaba 5.000-10.000€ y exigía un equipo de 3 personas un mes. Hoy lo monto solo en 7-14 días gracias a IA, n8n y herramientas modernas.',
      },
      {
        title: 'La solución',
        description:
          'Yo cierro el gap. Tengo el conocimiento técnico, las herramientas modernas, y vivo aquí. Tú tienes el negocio y el problema. Hablamos 15 minutos, te digo si puedo ayudarte, y si encaja lo monto.',
      },
    ]}
  />

  <!-- Cómo trabajo -->
  <Steps2
    title="Cómo trabajo"
    subtitle="Sin sorpresas, sin letra pequeña, sin perder el tiempo."
    isReversed={true}
    items={[
      {
        title: 'Precio cerrado, no por horas',
        description: 'Lo que ves en mi web es lo que pagas. Sin "depende", sin "consultar", sin presupuestos personalizados ocultos.',
        icon: 'tabler:cash',
      },
      {
        title: '50% al firmar, 50% al entregar',
        description: 'Compromiso por las dos partes. Empezamos cuando entra el 50%. Cierras cuando recibes y validas.',
        icon: 'tabler:file-check',
      },
      {
        title: 'Garantía 30 días o devolución',
        description: 'Si en 30 días el sistema no funciona como acordamos en el contrato, te devuelvo el dinero íntegro.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Documentación clara',
        description: 'Te paso vídeo + texto explicando cómo funciona todo. Si me voy a la luna mañana, sigues operativo.',
        icon: 'tabler:book',
      },
    ]}
  />

  <!-- Dónde estoy -->
  <Features2
    title="Dónde estoy"
    tagline="Ubicación"
    columns={3}
    items={[
      {
        title: 'Sede',
        description: 'Alhama de Murcia (España). Aquí pienso, aquí construyo, aquí vivo.',
        icon: 'tabler:home',
      },
      {
        title: 'Presencial',
        description: 'Murcia capital, Cartagena, Lorca, Molina, Alcantarilla y costa. Radio de 50 km.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Remoto',
        description: 'Toda España. La mayoría del trabajo se hace por videollamada y email.',
        icon: 'tabler:device-laptop',
      },
    ]}
  />

  <!-- Cómo contactar -->
  <Features2
    title="Cómo contactarme"
    tagline="Hablamos"
    columns={2}
    items={[
      {
        title: 'WhatsApp (recomendado)',
        description: 'Es donde más rápido te contesto. Lunes a viernes.',
        icon: 'tabler:brand-whatsapp',
      },
      {
        title: 'Email',
        description: 'juanpedro@automatizamurcia.com — respuesta en menos de 24h laborables.',
        icon: 'tabler:mail',
      },
    ]}
  />

  <!-- CTA -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Hablar por WhatsApp',
        href: WHATSAPP_LINK,
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      {
        text: 'Escribir un email',
        href: 'mailto:juanpedro@automatizamurcia.com',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">¿Hablamos 15 minutos?</Fragment>

    <Fragment slot="subtitle">
      Sin compromiso, sin discurso comercial. Me cuentas qué necesitas y te digo
      si puedo ayudarte. Si no encaja, te lo digo directamente y nos despedimos como amigos.
    </Fragment>
  </CallToAction>
</Layout>
