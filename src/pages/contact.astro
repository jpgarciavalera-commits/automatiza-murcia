---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const WHATSAPP_LINK = 'https://wa.me/34618324653';

const metadata = {
  title: 'Contacto — Automatiza Murcia',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <HeroText
    tagline="Contacto"
    title="Hablamos 15 minutos"
    subtitle="Sin compromiso. Me cuentas qué problema concreto quieres resolver y te digo si tiene sentido contratarme. Si no encaja, te lo digo directamente. La forma más rápida es WhatsApp."
  />

  <!-- Canales de contacto -->
  <Features2
    title="Cómo llegar a mí"
    tagline="Canales"
    columns={3}
    items={[
      {
        title: 'WhatsApp (lo más rápido)',
        description: 'Escríbeme y te contesto en horario laboral en menos de 2h.',
        icon: 'tabler:brand-whatsapp',
        callToAction: {
          target: '_blank',
          text: 'Abrir WhatsApp',
          href: WHATSAPP_LINK,
        },
      },
      {
        title: 'Email',
        description: 'juanpedro@automatizamurcia.com — respuesta en menos de 24h laborables.',
        icon: 'tabler:mail',
      },
      {
        title: 'LinkedIn',
        description: 'Mándame un DM o mira mi perfil profesional.',
        icon: 'tabler:brand-linkedin',
      },
    ]}
  />

  <!-- Formulario -->
  <ContactUs
    id="form"
    title="O escríbeme aquí directamente"
    subtitle="Si prefieres formulario antes que WhatsApp, te leo. Te contesto al email que me dejes en menos de 24h laborables."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Tu nombre',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Tu email',
      },
      {
        type: 'text',
        name: 'business',
        label: 'Tu negocio (opcional)',
      },
    ]}
    textarea={{
      label: 'Qué problema quieres resolver',
      placeholder: 'Cuéntame en 2-3 líneas qué te trae aquí. Cuanto más concreto, mejor te puedo ayudar.',
    }}
    disclaimer={{
      label:
        'Al enviar este formulario aceptas que use tus datos solo para contestarte. No te apunto a ninguna lista de spam ni revendo nada.',
    }}
    description="Te contesto en menos de 24h laborables."
  />

  <!-- Datos -->
  <Features2
    title="Datos rápidos"
    columns={2}
    items={[
      {
        title: 'Email',
        description: 'juanpedro@automatizamurcia.com',
        icon: 'tabler:mail',
      },
      {
        title: 'WhatsApp',
        description: 'Lunes a viernes en horario laboral',
        icon: 'tabler:brand-whatsapp',
      },
      {
        title: 'Ubicación',
        description: 'Alhama de Murcia, España. Atiendo presencial Murcia + 50 km y remoto toda España.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Horario',
        description: 'Lunes a viernes. Fines de semana descansamos los dos.',
        icon: 'tabler:clock',
      },
    ]}
  />
</Layout>
